# SPDX-License-Identifier: MIT OR Apache-2.0
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{toml,json}]
indent_size = 2

[justfile]
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf
